{{- /*
  Machine configuration. Rendered by `chezmoi init`; answers are remembered in
  ~/.config/chezmoi/chezmoi.toml, so re-running init never asks twice.

  Non-interactive: set DEVENV_PROFILE / DEVENV_NAME / DEVENV_EMAIL (a single space
  means "blank on purpose": no prompt, no default) and pass
  --promptDefaults so anything unset falls back to its default instead of prompting.
  Defaults: profile "dev", "minimal" on Alpine and no-sudo machines (DEVENV_DEFAULT_PROFILE overrides; install.sh uses "full"
  when migrating from v1); name and email from the existing git config (global,
  else ~/.gitconfig.local), but the
  email only if it is a GitHub noreply address, else from `gh` when logged in.
  Component overrides: DEVENV_ADD / DEVENV_REMOVE (comma-separated; a single space
  empties the list) at init time, or `dev profile --add/--remove`,
  or edit [data.components] in the generated config and re-run `chezmoi init`.
*/ -}}
{{- $profiles := list "minimal" "dev" "full" -}}
{{- /* No-sudo machines: remembered; DEVENV_NO_SUDO=1 turns it on, 0 off. */ -}}
{{- $nosudo := dig "nosudo" false . -}}
{{- with env "DEVENV_NO_SUDO" }}{{ $nosudo = eq . "1" }}{{ end -}}

{{- /* Alpine and no-sudo machines are minimal-only targets (docs/v2-design.md); elsewhere "dev". */ -}}
{{- $fallback := "dev" -}}
{{- if or $nosudo (eq (dig "osRelease" "id" "" .chezmoi) "alpine") }}{{ $fallback = "minimal" }}{{ end -}}
{{- $profile := env "DEVENV_PROFILE" -}}
{{- if not $profile -}}
{{-   $profile = promptChoiceOnce . "profile" "Profile — minimal: shell+editor+CLI tools | dev: +Docker & languages | full: +Kubernetes & Java" $profiles (env "DEVENV_DEFAULT_PROFILE" | default $fallback) -}}
{{- end -}}
{{- if not (has $profile $profiles) }}{{ fail (printf "unknown profile %q (known: %s)" $profile (join ", " $profiles)) }}{{ end -}}
{{- /* A POSIX sh for the default lookups below. Windows: the one Git for Windows
       ships (bin\sh.exe beside cmd\git.exe); without one the defaults are blank. */ -}}
{{- $sh := lookPath "sh" -}}
{{- if and (not $sh) (lookPath "git") -}}
{{-   $gitsh := joinPath (lookPath "git" | osDir | osDir) "bin" "sh.exe" -}}
{{-   if stat $gitsh }}{{ $sh = $gitsh }}{{ end -}}
{{- end -}}
{{- $name := env "DEVENV_NAME" -}}
{{- if not $name -}}
{{-   $default := "" -}}
{{-   if and $sh (not (hasKey . "name")) }}{{ $default = output $sh "-c" "git config --global --get user.name 2>/dev/null || git config --file \"$HOME/.gitconfig.local\" --get user.name 2>/dev/null || true" | trim }}{{ end -}}
{{-   $name = promptStringOnce . "name" "Git author name (blank to skip)" $default -}}
{{- end -}}
{{- $email := env "DEVENV_EMAIL" -}}
{{- if not $email -}}
{{-   $default := "" -}}
{{-   if not (hasKey . "email") -}}
{{-     if $sh }}{{ $default = output $sh "-c" "git config --global --get user.email 2>/dev/null || git config --file \"$HOME/.gitconfig.local\" --get user.email 2>/dev/null || true" | trim }}{{ end -}}
{{-     if and $sh (not (hasSuffix "@users.noreply.github.com" $default)) (lookPath "gh") -}}
{{-       $default = output $sh "-c" "gh api user --jq '\"\\(.id)+\\(.login)@users.noreply.github.com\"' 2>/dev/null || true" | trim -}}
{{-     end -}}
{{-     if not (hasSuffix "@users.noreply.github.com" $default) }}{{ $default = "" }}{{ end -}}
{{-   end -}}
{{-   $email = promptStringOnce . "email" "Git author email (GitHub noreply recommended, blank to skip)" $default -}}
{{- end -}}

{{- $flavors := list "latte" "frappe" "macchiato" "mocha" -}}
{{- $flavor := env "DEVENV_THEME" | default (dig "theme" "flavor" "" .) -}}
{{- if and $flavor (not (has $flavor $flavors)) }}{{ fail (printf "unknown theme flavor %q (known: %s)" $flavor (join ", " $flavors)) }}{{ end -}}

{{- $known := list "docker" "devtools" "node" "python" "go" "rust" "kubernetes" "java" "cloud" -}}
{{- $add := dig "components" "add" (list) . -}}
{{- $remove := dig "components" "remove" (list) . -}}
{{- /* A single space means "none" (dev remove empties a list that way). */ -}}
{{- with env "DEVENV_ADD" }}{{ $add = splitList "," (trim .) | compact }}{{ end -}}
{{- with env "DEVENV_REMOVE" }}{{ $remove = splitList "," (trim .) | compact }}{{ end -}}
{{- range (concat $add $remove) }}{{ if not (has . $known) }}{{ fail (printf "unknown component %q (known: %s)" . (join ", " $known)) }}{{ end }}{{ end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
profile = {{ $profile | quote }}
name = {{ $name | trim | quote }}
email = {{ $email | trim | quote }}
# Never use sudo here (root-only steps are skipped and listed in ~/.local/state/dev/skipped.log).
nosudo = {{ $nosudo }}

[data.components]
# Applied on top of the profile. Known: {{ join ", " $known }}
add = [{{ range $i, $c := $add }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}]
remove = [{{ range $i, $c := $remove }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}]

{{- if $flavor }}

[data.theme]
# Catppuccin flavor for every tool on this machine (default from .chezmoidata/theme.yaml).
flavor = {{ $flavor | quote }}
{{- end }}

[diff]
exclude = ["scripts"]
{{- if eq .chezmoi.os "windows" }}

# The install scripts run whatever this machine's execution policy (Windows 10/11
# default to Restricted); -ExecutionPolicy here applies to that process only.
[interpreters.ps1]
command = "powershell"
args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{- end }}
