{{- /* Third-party files chezmoi fetches into $HOME. Refreshed weekly by `chezmoi apply`. */ -}}
{{- $f := .theme.flavor -}}
{{- $F := .theme.flavor | title -}}
{{- $raw := "https://raw.githubusercontent.com" -}}

# ---- plugin managers
[".local/share/zinit/zinit.git"]
type = "git-repo"
url = "https://github.com/zdharma-continuum/zinit.git"
refreshPeriod = "168h"

[".tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm.git"
refreshPeriod = "168h"

# ---- Catppuccin {{ $F }} theme files
[".config/bat/themes/Catppuccin {{ $F }}.tmTheme"]
type = "file"
url = "{{ $raw }}/catppuccin/bat/main/themes/Catppuccin%20{{ $F }}.tmTheme"
refreshPeriod = "168h"

[".config/btop/themes/catppuccin_{{ $f }}.theme"]
type = "file"
url = "{{ $raw }}/catppuccin/btop/main/themes/catppuccin_{{ $f }}.theme"
refreshPeriod = "168h"

[".config/eza/theme.yml"]
type = "file"
url = "{{ $raw }}/catppuccin/eza/main/themes/{{ $f }}/catppuccin-{{ $f }}-blue.yml"
refreshPeriod = "168h"

{{- /* yazi uses the configured flavor when dark and latte when light */}}
{{- range (list $f "latte" | uniq) }}

[".config/yazi/flavors/catppuccin-{{ . }}.yazi/flavor.toml"]
type = "file"
url = "{{ $raw }}/yazi-rs/flavors/main/catppuccin-{{ . }}.yazi/flavor.toml"
refreshPeriod = "168h"

[".config/yazi/flavors/catppuccin-{{ . }}.yazi/tmtheme.xml"]
type = "file"
url = "{{ $raw }}/yazi-rs/flavors/main/catppuccin-{{ . }}.yazi/tmtheme.xml"
refreshPeriod = "168h"
{{- end }}
