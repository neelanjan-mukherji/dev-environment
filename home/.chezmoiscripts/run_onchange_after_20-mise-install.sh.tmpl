#!/usr/bin/env bash
# Re-runs whenever the rendered tool list changes:
# {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}
set -Eeuo pipefail
{{ template "lib.sh" . }}

step "CLI tools and languages (mise)"
if ! command -v mise >/dev/null 2>&1; then
    warn "mise is not installed; run install.sh first."
    exit 1
fi
info "Profile {{ .profile }}; components: {{ includeTemplate "components" . | default "none" }}"
run mise install --yes
