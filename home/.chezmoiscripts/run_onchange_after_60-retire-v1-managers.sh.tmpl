{{- $on := includeTemplate "components" . | splitList "," -}}
#!/usr/bin/env bash
# SDKMAN and nvm are replaced by mise. Each is removed only after mise proves the
# replacement works. Components: {{ join "," $on }}
set -Eeuo pipefail
{{ template "lib.sh" . }}

retire() { # retire <dir> <what> <check command...>
    local dir="$1" what="$2"; shift 2
    [ -d "$dir" ] || return 0
    step "Retire $what"
    if ! "$@" >/dev/null 2>&1; then
        info "Keeping $dir: mise has not verified a replacement yet."
        return 0
    fi
    if confirm "mise now provides this. Remove $dir?"; then
        run rm -rf -- "$dir"
    else
        record_skip "removing $dir (declined)"
    fi
}

{{ if has "java" $on -}}
retire "$HOME/.sdkman" "SDKMAN (Java, Maven, Spring Boot)" mise exec -- java -version
{{ end -}}
{{ if has "node" $on -}}
retire "${NVM_DIR:-$HOME/.nvm}" "nvm (Node)" mise exec -- node --version
{{ end -}}
:
