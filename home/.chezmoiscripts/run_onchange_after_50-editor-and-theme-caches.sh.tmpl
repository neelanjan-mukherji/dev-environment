#!/usr/bin/env bash
# Re-runs when plugin locks or the theme change:
# lazy-lock {{ include "dot_config/nvim/lazy-lock.json" | sha256sum }}
# theme {{ .theme.flavor }}
set -Eeuo pipefail
{{ template "lib.sh" . }}

step "Theme caches and editor plugins"
if command -v bat >/dev/null 2>&1; then
    run bat cache --build >/dev/null
fi
if command -v nvim >/dev/null 2>&1; then
    # Install plugins at the versions pinned in lazy-lock.json.
    run nvim --headless "+Lazy! restore" +qa
fi
tpm_install="$HOME/.tmux/plugins/tpm/bin/install_plugins"
if [ -x "$tpm_install" ] && command -v tmux >/dev/null 2>&1; then
    run "$tpm_install" >/dev/null || warn "tmux plugins will install on first use (prefix + I)."
fi
