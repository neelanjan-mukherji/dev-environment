{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Re-runs when a Linux package list changes: {{ list .packages.apt .packages.dnf .packages.pacman .packages.apk | toJson | sha256sum }}
set -Eeuo pipefail
{{ template "lib.sh" . }}

step "System packages"
# shellcheck source=/dev/null
. /etc/os-release
pm="$(package_manager)"
case "$pm" in
    apt) wanted=({{ range .packages.apt }} {{ . | quote }}{{ end }} ) ;;
    dnf) wanted=({{ range .packages.dnf }} {{ . | quote }}{{ end }} ) ;;
    pacman) wanted=({{ range .packages.pacman }} {{ . | quote }}{{ end }} ) ;;
    apk) wanted=({{ range .packages.apk }} {{ . | quote }}{{ end }} ) ;;
    *)
        record_skip "system packages: no apt, dnf, pacman or apk on ${PRETTY_NAME:-this distro}"
        exit 0 ;;
esac

missing=()
for pkg in "${wanted[@]}"; do
    pkg_installed "$pm" "$pkg" || missing+=("$pkg")
done

if [ "${#missing[@]}" -eq 0 ]; then
    info "All ${#wanted[@]} base packages already installed ($pm)."
    exit 0
fi

info "Missing ($pm): ${missing[*]}"
if ! can_sudo; then
    record_skip "system packages (no sudo): ${missing[*]}"
    exit 0
fi
pkg_install "$pm" "${missing[@]}"
{{- end }}
