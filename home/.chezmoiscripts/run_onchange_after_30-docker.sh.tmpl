{{- $on := includeTemplate "components" . | splitList "," -}}
{{- if and (eq .chezmoi.os "linux") (has "docker" $on) -}}
#!/usr/bin/env bash
set -Eeuo pipefail
{{ template "lib.sh" . }}

step "Docker Engine"
# shellcheck source=/dev/null
. /etc/os-release

if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    info "Already installed: $(docker --version)"
else
    if ! is_debian_like; then
        record_skip "docker: ${PRETTY_NAME:-this distro} is not supported yet (planned: milestone 4)"
        exit 0
    fi
    # Docker publishes repos for Ubuntu and Debian; derivatives use their base's.
    if [ -n "${UBUNTU_CODENAME:-}" ]; then repo_os=ubuntu codename="$UBUNTU_CODENAME"
    else repo_os=debian codename="${VERSION_CODENAME:?}"; fi
    if ! can_sudo; then record_skip "docker (needs sudo)"; exit 0; fi

    # Distro packages that conflict with Docker's own.
    conflicting=()
    for pkg in docker.io docker-doc docker-compose podman-docker containerd runc; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' && conflicting+=("$pkg")
    done
    if [ "${#conflicting[@]}" -gt 0 ]; then
        info "These distro packages conflict with Docker Engine: ${conflicting[*]}"
        if ! confirm "Remove them and install Docker Engine from download.docker.com?"; then
            record_skip "docker (conflicting packages kept: ${conflicting[*]})"
            exit 0
        fi
        as_root apt-get remove -y "${conflicting[@]}"
    fi
    as_root install -m 0755 -d /etc/apt/keyrings
    run curl -fsSL "https://download.docker.com/linux/${repo_os}/gpg" -o "$DEVENV_STATE/docker.gpg"
    as_root gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg "$DEVENV_STATE/docker.gpg"
    rm -f "$DEVENV_STATE/docker.gpg"
    as_root chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${repo_os} ${codename} stable" |
        as_root tee /etc/apt/sources.list.d/docker.list >/dev/null
    as_root apt-get update -qq
    as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

user="$(id -un)"
if ! id -nG "$user" | grep -qw docker; then
    info "Members of the docker group can run containers without sudo (effectively root on this machine)."
    if confirm "Add $user to the docker group?" && can_sudo; then
        as_root usermod -aG docker "$user"
        info "Takes effect after you log out and back in."
        is_wsl && info "On WSL: run 'wsl.exe --shutdown' from Windows, then reopen the terminal."
    else
        record_skip "docker group membership for $user"
    fi
fi

systemd_state="$(systemctl is-system-running 2>/dev/null || true)"
if [ "$systemd_state" = running ] || [ "$systemd_state" = degraded ] || [ "$systemd_state" = starting ]; then
    if ! systemctl is-active --quiet docker; then
        as_root systemctl enable --now docker
    fi
elif is_wsl; then
    info "The Docker daemon needs systemd, which is off in this WSL distro."
    current_conf="$(cat /etc/wsl.conf 2>/dev/null || true)"
    wanted_conf="$(printf '%s\n' "$current_conf" | wsl_conf_with_systemd)"
    if [ "$current_conf" = "$wanted_conf" ]; then
        info "systemd is already enabled in /etc/wsl.conf; restart WSL with 'wsl.exe --shutdown' from Windows."
        exit 0
    fi
    info "Proposed change to /etc/wsl.conf:"
    diff <(printf '%s\n' "$current_conf") <(printf '%s\n' "$wanted_conf") | sed 's/^/      /' || true
    if confirm "Write this to /etc/wsl.conf?" && can_sudo; then
        printf '%s\n' "$wanted_conf" | as_root tee /etc/wsl.conf >/dev/null
        info "Done. Run 'wsl.exe --shutdown' from Windows, reopen the terminal, then re-run setup."
    else
        record_skip "docker daemon: systemd not enabled in /etc/wsl.conf"
    fi
else
    record_skip "docker daemon: systemd is not running here (container?); start dockerd yourself"
fi
{{- end }}
