{{- $on := includeTemplate "components" . | splitList "," -}}
{{- /* Alpine (musl): Neovim and jless publish only glibc builds, and ripgrep and eza
       none for arm64 musl, so apk installs those four (packages.yaml). */ -}}
{{- $alpine := eq (dig "osRelease" "id" "" .chezmoi) "alpine" -}}
{{- /* jless publishes no Linux arm64 build: left out there (dev doctor skips it too). */ -}}
{{- $jless := not (or $alpine (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64"))) -}}
# Managed by chezmoi from ~/dev-environment (profile: {{ .profile }}). Edit the source, not this file.
# Policy: small CLI tools track "latest"; toolchains are pinned and bumped deliberately.

[settings]
# Honour per-project .nvmrc / .node-version / .java-version / .python-version files.
idiomatic_version_file_enable_tools = ["node", "java", "python"]
# Maven Central and archive.apache.org rate-limit (429) or stall under load; the
# default 3 quick retries give up within seconds, 6 back off for a few minutes.
http_retries = 6

[tools]
# ---- core CLI (every profile)
bat = "latest"
btop = "latest"
duf = "latest"
{{- if not $alpine }}
eza = "latest"
{{- end }}
fd = "latest"
fzf = "latest"
gh = "latest"
{{- if $jless }}
jless = "latest"
{{- end }}
jq = "latest"
lazygit = "latest"
{{- if not $alpine }}
# Pinned: config targets the Neovim 0.11 LSP API and nvim-treesitter master.
neovim = "0.11"
{{- end }}
{{- if not $alpine }}
ripgrep = "latest"
{{- end }}
starship = "latest"
{{- if ne .chezmoi.os "darwin" }}
tmux = "latest" # macOS: Homebrew (packages.yaml)
{{- end }}
yazi = "latest"
zoxide = "latest"
{{- if has "devtools" $on }}

# ---- devtools
"github:tbillington/kondo" = "latest"
{{- end }}
{{- if has "node" $on }}

# ---- node
node = "26"
{{- end }}
{{- if has "python" $on }}

# ---- python
python = "3.14"
uv = "latest"
{{- end }}
{{- if has "go" $on }}

# ---- go
go = "1.27"
{{- end }}
{{- if has "rust" $on }}

# ---- rust
rust = "stable"
{{- end }}
{{- if has "java" $on }}

# ---- java (first entry is the default; switch per project with .java-version or `mise use`)
java = ["corretto-21", "corretto-25", "corretto-17", "corretto-8"]
maven = "latest"
gradle = "latest"
spring-boot = "4.1"   # pinned: "latest" includes milestone builds (4.2.0-M2)
{{- end }}
{{- if has "kubernetes" $on }}

# ---- kubernetes
kubectl = "1.37"
helm = "latest"
k9s = "latest"
{{- end }}
{{- if has "cloud" $on }}

# ---- cloud
awscli = "latest"
gcloud = "latest"
"pipx:azure-cli" = "latest"
{{- end }}
