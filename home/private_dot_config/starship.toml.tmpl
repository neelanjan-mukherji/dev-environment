{{- $t := index .catppuccin .theme.flavor -}}
# Managed by chezmoi. Colour names below resolve through the Catppuccin palette.
palette = "catppuccin_{{ .theme.flavor }}"
add_newline = false
command_timeout = 1000
format = "$username$hostname$directory$git_branch$git_status$fill$cmd_duration\n$character"
[username]
show_always = true
style_user = "bold green"
style_root = "bold red"
format = "[$user]($style) "
[hostname]
ssh_only = false
format = "[@$hostname ](overlay1)"
[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold blue"
format = "[$path]($style) "
[git_branch]
symbol = "git:"
style = "bold green"
format = "[$symbol$branch]($style) "
[git_status]
style = "bold yellow"
format = "([$all_status$ahead_behind]($style) )"
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕"
untracked = "?"
modified = "!"
staged = "+"
deleted = "✘"
[cmd_duration]
min_time = 2000
format = "[took $duration]($style) "
style = "peach"
[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold yellow)"
[fill]
symbol = " "
[docker_context]
disabled = true
[kubernetes]
disabled = true

[palettes.catppuccin_{{ .theme.flavor }}]
{{- range $name, $hex := $t.colors }}
{{ $name }} = {{ $hex | quote }}
{{- end }}
