{{- $c := (index .catppuccin .theme.flavor).colors -}}
# Environment shared by zsh and bash (interactive shells).

export EDITOR='nvim'
export VISUAL='nvim'

export FZF_DEFAULT_OPTS="
    --height 60%
    --layout=reverse
    --border=rounded
    --info=inline
    --margin=1
    --color=bg+:{{ $c.surface0 }},bg:{{ $c.base }},spinner:{{ $c.rosewater }},hl:{{ $c.red }}
    --color=fg:{{ $c.text }},header:{{ $c.red }},info:{{ $c.mauve }},pointer:{{ $c.rosewater }}
    --color=marker:{{ $c.lavender }},fg+:{{ $c.text }},prompt:{{ $c.mauve }},hl+:{{ $c.red }}
    --color=selected-bg:{{ $c.surface1 }},border:{{ $c.overlay0 }},label:{{ $c.text }}
"

if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
