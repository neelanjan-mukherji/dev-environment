-- WezTerm (macOS for now; Linux desktops and Windows follow). Managed by chezmoi
-- from ~/dev-environment: edit the source, not this file.
local wezterm = require("wezterm")
local config = wezterm.config_builder()

config.color_scheme = "Catppuccin {{ .theme.flavor | title }}"
config.font = wezterm.font("JetBrainsMono Nerd Font")
config.font_size = 14
config.line_height = 1.1

config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = false
config.window_decorations = "RESIZE"
config.window_padding = { left = 8, right = 8, top = 8, bottom = 4 }
config.audible_bell = "Disabled"
config.scrollback_lines = 10000

-- Left Option is Meta (Alt keybindings in zsh, tmux and Neovim); right Option
-- still types symbols such as # and @ on non-US layouts.
config.send_composed_key_when_left_alt_is_pressed = false
config.send_composed_key_when_right_alt_is_pressed = true

return config
