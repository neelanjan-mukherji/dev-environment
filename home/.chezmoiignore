{{- /* Targets that only make sense on some OSes. */ -}}
{{ if ne .chezmoi.os "darwin" }}
.config/wezterm
{{ end }}
{{ if eq .chezmoi.os "windows" }}
{{- /* The Windows host gets the shared configs (git, nvim, starship, lazygit)
       plus its PowerShell and Terminal files; the Unix shells live in WSL. */}}
.chezmoiscripts/*.sh
.bashrc
.profile
.tmux.conf
.zprofile
.zshenv
.zshrc
.local
.tmux
.config/bat
.config/btop
.config/eza
.config/mise
.config/shell
.config/yazi
.config/zsh
{{ else }}
.chezmoiscripts/*.ps1
.config/powershell
AppData
{{ end }}
{{- /* desktop: VS Code's user settings.json, at each OS's own path, only with desktop on.
       Inside WSL (the kernel release says "microsoft", as lib.sh's is_wsl reads it)
       VS Code is the Windows host's, and so are its settings. */}}
{{ $desktop := includeTemplate "components" . | splitList "," | has "desktop" }}
{{ $wsl := dig "kernel" "osrelease" "" .chezmoi | lower | contains "microsoft" }}
{{ if or (ne .chezmoi.os "linux") (not $desktop) $wsl }}
.config/Code
{{ end }}
{{ if ne .chezmoi.os "darwin" }}
Library
{{ else if not $desktop }}
Library/Application Support/Code
{{ end }}
{{ if not $desktop }}
AppData/Roaming/Code
{{ end }}
